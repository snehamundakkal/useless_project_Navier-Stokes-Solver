# ─────────────────────────────────────────────────────────────────────
# LLM Navier-Stokes Solver — Environment Configuration TEMPLATE
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────

# Your OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# (Optional) Default model — can also be changed in the app sidebar
OPENAI_MODEL=gpt-4o-mini

# (Optional) Set to "true" to force Demo Mode even with a valid key
DEMO_MODE=false
